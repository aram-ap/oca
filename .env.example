# OCA settings. Copy to .env (gitignored). Only OCA_* keys are read; anything else is ignored.

# Storage
OCA_DB_PATH=data/oca.db
OCA_DATA_DIR=data

# Company under test: a standalone clone of the driftwood repo (own git history, baseline tag).
OCA_FAKECO_ROOT=../driftwood
# real = OCA-owned Compose sandbox + company production ops; dry = in-memory FakeRunner
OCA_RUNNER=dry
# Operator-owned company profile; blank selects OCA's bundled Driftwood profile.
# Runtime worktrees, generated Compose files, and logs live under OCA_DATA_DIR/sandboxes/.
OCA_SANDBOX_PROFILE=

# Platform server (driftwood owns 8000/8080, so OCA uses 8001)
OCA_HOST=127.0.0.1          # 0.0.0.0 to reach the dashboard from another machine on the LAN
OCA_PORT=8001
OCA_API_URL=http://localhost:8001

# Driftwood endpoints
OCA_PROM_URL=http://localhost:9090
OCA_SANDBOX_PROM_URL=http://localhost:19090
OCA_SANDBOX_API_URL=http://localhost:18000
OCA_SERVICE_URLS=orders-api=http://localhost:8000,frontend=http://localhost:8080

# Local model
OCA_OLLAMA_URL=http://localhost:11434
OCA_MODEL=nemotron3:33b
OCA_LLM_TIMEOUT_S=120
OCA_MODEL_KEEP_ALIVE=5m
OCA_TOOL_TIMEOUT_S=30
OCA_HARDWARE=ASUS Ascent GX10

# Per-client bearer tokens (dev values; change for anything beyond the demo box)
OCA_INVESTIGATOR_TOKEN=agent-investigator
OCA_ENGINEER_TOKEN=agent-engineer
OCA_GUARDIAN_TOKEN=agent-guardian
OCA_ORCHESTRATOR_TOKEN=orchestrator
OCA_HEALTH_TOKEN=health
OCA_JIRA_TOKEN=jira
OCA_SLACK_TOKEN=slack

# Dashboard login
OCA_ADMIN_USER=admin
OCA_ADMIN_PASSWORD=admin
OCA_SECRET_KEY=dev-secret-change-me

# Policy (seeded into the settings table on first boot; the DB wins afterwards)
OCA_REQUIRE_HUMAN_APPROVAL=true
OCA_RISK_THRESHOLD=30

# Timing
OCA_CHECK_INTERVAL_S=10
OCA_SCHEDULER_TICK_S=2
OCA_STAGE_DELAY_S=3
OCA_VERIFY_RUNS=3
OCA_VERIFY_INTERVAL_S=10
OCA_MAX_ATTEMPTS=2
OCA_LOADTEST_REQUESTS=2000
OCA_AUTOSTART_PIPELINE=true
