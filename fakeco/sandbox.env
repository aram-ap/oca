# Sandbox stack: an isolated copy of production on offset ports.
#   docker compose -p driftwood-sandbox --env-file sandbox.env up -d --build
FRONTEND_PORT=18080
API_PORT=18000
PG_PORT=15432
REDIS_PORT=16379
PROM_PORT=19090
LOG_DIR=./logs-sandbox

SEED_ORDERS=2000000
SEED_CUSTOMERS=250000

# No background traffic: the sandbox is measured with fixed-size load tests.
LOADGEN_REPLICAS=0
